{
  "name": "@lastthaw/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,worker,ai -c blue,magenta,yellow \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:ai\"",
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/api/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker/index.ts",
    "dev:ai": "tsx watch --env-file-if-exists=../../.env src/worker/ai.ts",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.0",
    "@lastthaw/shared": "*",
    "argon2": "^0.45.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.27.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.0",
    "vitest": "^5.0.0"
  }
}
