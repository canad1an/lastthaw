# Copy to .env for local development. docker-compose reads this file too.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://lastthaw:lastthaw@localhost:5432/lastthaw
REDIS_URL=redis://localhost:6379
# Random 32+ char string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Local mail goes to Mailpit (http://localhost:8025). Prod uses SES SMTP creds.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Last Thaw <noreply@lastthaw.com>
PUBLIC_URL=http://localhost:5173
# Enables dev-only endpoints such as time-skip. Never true in production.
DEV_TOOLS=true
