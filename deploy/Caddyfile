# Production reverse proxy for the dedicated Last Thaw Lightsail instance.
# Caddy obtains and renews the TLS certificate for lastthaw.com automatically.
lastthaw.com, www.lastthaw.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://stats.lastthaw.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://stats.lastthaw.com; connect-src 'self' wss://lastthaw.com wss://www.lastthaw.com https://stats.lastthaw.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # Match pages and the archive of past matches come from the API with their own title, description, sharing card,
    # structured data and the page's words already in the HTML.
    handle /matches/past {
        reverse_proxy {
            dynamic a api 3000 {
                refresh 2s
            }
            health_interval 3s
            health_timeout 2s
        }
    }
    handle /match/* {
        reverse_proxy {
            dynamic a api 3000 {
                refresh 2s
            }
            health_interval 3s
            health_timeout 2s
        }
    }

    handle /sitemap.xml {
        reverse_proxy {
            dynamic a api 3000 {
                refresh 2s
            }
            lb_try_duration 15s
        }
    }

    handle /api/* {
        reverse_proxy {
            dynamic a api 3000 {
                refresh 2s
            }
            lb_policy round_robin
            # A replica being replaced during a deploy is skipped: the request waits for a live one instead of a 503.
            lb_try_duration 15s
            lb_try_interval 250ms
            fail_duration 10s
            health_uri /api/health
            health_interval 3s
            health_timeout 2s
        }
    }

    handle {
        root * /srv/web
        # Hashed assets never change, so they may be kept for a year; the page itself and everything else
        # must be checked on every load, or a phone keeps running last week's bundle after a deploy.
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @page not path /assets/*
        header @page Cache-Control "no-cache"
        # The public pages are prerendered at build time (apps/web/scripts/prerender.ts): the home page is home.html and
        # /how-to-play is how-to-play.html, with the page's own words in the HTML for crawlers and link previews. Every
        # other address gets the plain index.html and the app renders it in the browser.
        @home path /
        rewrite @home /home.html
        try_files {path} {path}.html /index.html
        file_server
    }
}

# Analytics. Matomo serves its own UI and the tracker; its headers are its own business apart from HSTS.
stats.lastthaw.com {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    header X-Content-Type-Options "nosniff"
    reverse_proxy matomo:80
}
